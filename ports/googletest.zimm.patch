diff --git a/ze_build.cpp b/ze_build.cpp
new file mode 100644
index 00000000..2f80c755
--- /dev/null
+++ b/ze_build.cpp
@@ -0,0 +1,36 @@
+#include "googletest/ze_build.hpp"
+
+#include <print>
+#include "googlemock/ze_build.hpp"
+
+using namespace zimm;
+
+int main(int argc, char* argv[]) {
+  auto cfg = make_config(argc, argv);
+  Project prj{"googletest-distribution", std::move(cfg.value())};
+
+  prj.add_global_property(CompileFlagProperty{"-std=c++17"});
+
+  auto gtest_tgts = define_gtest();
+  prj.register_top_level_target(gtest_tgts.gtest_main.get());
+
+  auto gmock_tgts = define_gmock(gtest_tgts.gtest.get());
+  prj.register_top_level_target(gmock_tgts.gmock_main.get());
+
+  prj.installer()->install_lib(gtest_tgts.gtest.get());
+  prj.installer()->install_lib(gtest_tgts.gtest_main.get());
+  prj.installer()->install_lib(gmock_tgts.gmock.get());
+  prj.installer()->install_lib(gmock_tgts.gmock_main.get());
+  prj.installer()->install_headers(Directory{rel_path("googletest/include")});
+  prj.installer()->install_headers(Directory{rel_path("googlemock/include")});
+
+  // TODO: gtest_build_tests / gmock_build_tests — requires test runner
+  // TODO: GTEST_HAS_ABSL — requires external Abseil/RE2 discovery
+  // TODO: gtest_hide_internal_symbols — requires symbol visibility control
+  // TODO: config_compiler_and_linker — requires per-build-type warning flags
+  // TODO: hermetic_build — requires hermetic toolchain isolation
+  // TODO: gtest_force_shared_crt — Windows-only, requires CMake-level CRT
+  // control
+
+  generate_build(prj);
+}
