diff --git a/googlemock/ze_build.hpp b/googlemock/ze_build.hpp
new file mode 100644
index 00000000..3bc0f848
--- /dev/null
+++ b/googlemock/ze_build.hpp
@@ -0,0 +1,25 @@
+#pragma once
+
+#include "zimm/zimm.hpp"
+
+using namespace zimm;
+
+struct GMockTargets {
+  LeakyPtr<StaticLibrary> gmock;
+  LeakyPtr<StaticLibrary> gmock_main;
+};
+
+inline GMockTargets define_gmock(StaticLibrary* gtest) {
+  auto gmock = make_static_library("gmock");
+  gmock->add_source(rel_path("src/gmock-all.cc"));
+  gmock->add_property(public_, IncludeProperty{rel_path("include")});
+  gmock->add_property(private_, IncludeProperty{rel_path("")});
+  gmock->link_with(public_, gtest);
+
+  auto gmock_main = make_static_library("gmock_main");
+  gmock_main->add_source(rel_path("src/gmock_main.cc"));
+  gmock_main->add_property(public_, IncludeProperty{rel_path("include")});
+  gmock_main->link_with(public_, gmock.get());
+
+  return {std::move(gmock), std::move(gmock_main)};
+}
